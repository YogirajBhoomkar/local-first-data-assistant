# Copy to .env (never commit .env). Every value below is a fake placeholder.

# Optional path to a JSON config file that overrides built-in defaults.
LF_CONFIG=./lf.config.json

# Remote model (used only when a question is escalated, through the privacy gate).
# Base URL of an OpenAI-compatible endpoint, or the Azure OpenAI resource URL.
LF_REMOTE_BASE_URL=https://example.invalid/v1
# Model name, or the Azure deployment name.
LF_REMOTE_MODEL=example-model
# API key. Never logged, redacted in any config dump.
LF_REMOTE_API_KEY=sk-example-not-a-real-key

# Local model tags per hardware tier (confirmed in Phase 2; placeholders until then).
# small tier  -> <QWEN_9B_TAG>
# medium tier -> <MINISTRAL_14B_TAG>
