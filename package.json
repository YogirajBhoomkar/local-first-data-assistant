{
  "name": "local-first-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p apps/cli && tsc -p scripts",
    "lint": "eslint .",
    "test": "vitest run",
    "probe": "tsx scripts/probe.ts",
    "gen:data": "tsx scripts/gen-synthetic.ts",
    "cli": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "commander": "15.1.0",
    "exceljs": "4.4.0",
    "hyparquet-writer": "0.18.0",
    "zod": "4.6.7"
  }
}
